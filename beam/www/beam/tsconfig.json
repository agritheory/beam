{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [
			"esnext",
			"DOM",
			"DOM.Iterable"
		],
		"jsx": "preserve",
		"isolatedModules": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"paths": {
			"@/*": [
				"./*"
			]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.d.ts",
		"**/*.vue"
	],
	"vueCompilerOptions": {
		"strictTemplates": true
	}
}
